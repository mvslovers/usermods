//ZMG03CK  JOB (USERMOD),'ZMG0003',CLASS=A,
//         MSGCLASS=H,MSGLEVEL=(1,1)
//*
//* ZMG0003 (IKJCT441 FOR REXX) - BEFORE YOU INSTALL
//*
//* LISTS THE REQUISITES OF ZMG0003.  READ THE LISTING, NOT THE
//* RETURN CODE:
//*   ZP60038, ZP60014 AND UY01301 MUST SHOW STATUS APP (APPLIED).
//*   A NAME UNDER "NOT FOUND" IS NOT INSTALLED.
//*   ZP60038 ALSO ACCEPTED (ACC) MAKES ZMG0003 REMOVABLE WITH RESTORE.
//*
//LIST     EXEC SMPAPP
//SMPCNTL  DD  *
 LIST CDS SYSMOD(UY01301,ZP60014,ZP60038,ZMG0003) .
 LIST ACDS SYSMOD(UY01301,ZP60014,ZP60038,ZMG0003) .
/*
//
