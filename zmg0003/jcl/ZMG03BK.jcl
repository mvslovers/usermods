//ZMG03BK  JOB (USERMOD),'ZMG0003',CLASS=A,
//         MSGCLASS=H,MSGLEVEL=(1,1)
//*
//* ZMG0003 (IKJCT441 FOR REXX) - BACK UP IKJPTGT BEFORE APPLY
//*
//* COPIES SYS1.LPALIB(IKJPTGT) AND ITS ALIASES INTO A NEW LIBRARY.
//* KEEP IT: THE STEP COPY OF ZMG03RS PUTS IT BACK.
//* CHANGE: YOUR.ZMG0003.BACKUP (TWICE, HERE AND IN ZMG03RS).
//*
//COPY     EXEC PGM=IEBCOPY,REGION=4096K
//SYSPRINT DD SYSOUT=*
//SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT4   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//IN       DD DSN=SYS1.LPALIB,DISP=SHR
//OUT      DD DSN=YOUR.ZMG0003.BACKUP,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(10,5,5)),
//            DCB=(RECFM=U,BLKSIZE=19069,DSORG=PO)
//SYSIN    DD *
  COPY INDD=IN,OUTDD=OUT
  SELECT MEMBER=(IKJPTGT,IKJGETL,IKJPUTL,IKJSTCK,IKJCT441)
/*
//
