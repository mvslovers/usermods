//ZMG03RS  JOB (USERMOD),'ZMG0003',CLASS=A,
//         MSGCLASS=H,MSGLEVEL=(1,1)
//*
//* ZMG0003 (IKJCT441 FOR REXX) - REMOVE
//*
//* STEP SMP: RESTORE TAKES ZMG0003 OUT OF THE INVENTORY AND RELINKS
//* IKJPTGT FROM THE DISTRIBUTION LIBRARY SYS1.AOST4.  RESTORE WORKS
//* ONLY WHEN ZP60038 IS ACCEPTED: OTHERWISE IT ENDS WITH HMA3022
//* "MISSING/NOGO REQUISITES".  THE STEP COPY THEN STILL BRINGS BACK
//* THE MODULE, BUT ZMG0003 STAYS IN THE INVENTORY.  ACCEPT THE
//* REQUISITES BEFORE THE INSTALL: SEE THE README OF THE USERMOD.
//*
//* STEP COPY PUTS THE IKJPTGT FROM BEFORE THE APPLY BACK (ZMG03BK).
//* CHANGE: YOUR.ZMG0003.BACKUP.
//*
//* THE REMOVAL BECOMES ACTIVE WITH THE NEXT IPL WITH CLPA.
//*
//SMP      EXEC SMPAPP
//HMASMP.LPALIB   DD DSN=SYS1.LPALIB,DISP=SHR
//HMASMP.AOST4    DD DSN=SYS1.AOST4,DISP=SHR
//HMASMP.SMPCNTL  DD *
 RESTORE SELECT(ZMG0003) .
/*
//COPY     EXEC PGM=IEBCOPY,REGION=4096K,COND=EVEN
//SYSPRINT DD SYSOUT=*
//SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT4   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//IN       DD DSN=YOUR.ZMG0003.BACKUP,DISP=SHR
//OUT      DD DSN=SYS1.LPALIB,DISP=SHR
//SYSIN    DD *
  COPY INDD=IN,OUTDD=OUT
  SELECT MEMBER=((IKJPTGT,,R),(IKJGETL,,R),(IKJPUTL,,R))
  SELECT MEMBER=((IKJSTCK,,R),(IKJCT441,,R))
/*
//
