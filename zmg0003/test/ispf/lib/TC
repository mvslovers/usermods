/* REXX */
N=3000
DO I=1 TO N; X=VALUE('V'I,I); END
ADDRESS ISPEXEC
"CONTROL ERRORS RETURN"
OK=0; MISS=''
DO I=1 TO N BY 250
N1='V'I
"VPUT ("N1") SHARED"
IF RC=0 THEN OK=OK+1; ELSE MISS=MISS N1
END
SAY 'TC VPUT RC=0:' OK 'OF 12; NICHT GESEHEN:' MISS
V1='VIEL'
"VPUT (V1) SHARED"; R1=RC
V1='XXX'
"VGET (V1) SHARED"; SAY 'TC V1 VPUT RC='R1 'VGET RC='RC 'V1='V1
EXIT 0
